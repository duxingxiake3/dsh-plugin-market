{
  "name": "dsh-plugin-market",
  "version": "0.1.0",
  "type": "module",
  "description": "Plugin Market for DeepSeek Harness — discover, review and install DSH plugins from the npm registry and GitHub.",
  "icon": "./dsh-market/logo.svg",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "plugin-market",
    "plugin-manager"
  ],
  "author": "duxingxiake3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duxingxiake3/dsh-plugin-market.git"
  },
  "homepage": "https://github.com/duxingxiake3/dsh-plugin-market#readme",
  "bugs": {
    "url": "https://github.com/duxingxiake3/dsh-plugin-market/issues"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "dsh-market/",
    "locale/*.json",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
